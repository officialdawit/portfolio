# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Only read by scripts/seed.ts when creating the first admin user
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-to-something-long"

# Vercel Web Analytics (admin dashboard). Token stays server-side.
# Create at vercel.com/account/tokens — read scope is enough.
VERCEL_TOKEN=""
ANALYTICS_PROJECT_ID="prj_xxxxxxxxxxxx"
# Named ANALYTICS_* on purpose: Vercel overrides anything prefixed VERCEL_
ANALYTICS_TEAM_ID=""

# "admin" enables the admin API routes; anything else 404s them
APP_TARGET="admin"

# Cal.com booking link, e.g. "dawit/30min" — PUBLIC, safe in the browser
VITE_CAL_LINK="your-username/30min"

# Cal.com API key — SERVER ONLY. Never prefix with VITE_, that ships it to
# every visitor and lets anyone read or cancel your bookings.
CAL_API_KEY=""
