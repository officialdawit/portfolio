# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Only read by scripts/seed.ts when creating the first admin user
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-to-something-long"

# Vercel Web Analytics (admin dashboard). Token stays server-side.
# Create at vercel.com/account/tokens — read scope is enough.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID="prj_xxxxxxxxxxxx"
# Only for team-owned projects; leave empty for a personal account
VERCEL_TEAM_ID=""
